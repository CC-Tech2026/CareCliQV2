SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Frontend Realtime reads SUPABASE_URL + SUPABASE_ANON_KEY from this file (via vite.config.ts).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Australian data residency: hosted Supabase must be in Sydney (ap-southeast-2).
SUPABASE_REGION=ap-southeast-2
# Application timezone for shift scheduling (IANA name). ap-southeast-2 is hosting only.
APP_TIMEZONE=Australia/Adelaide
# Optional: verify live project region via Supabase Management API (recommended for deploy).
# SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
# Set to disabled for local Supabase CLI or CI with mock credentials.
# SUPABASE_REGION_CHECK=disabled
SESSION_SECRET=change-this-to-a-long-random-secret
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins for API CORS (mobile web :8081; add LAN IP for Expo Go on phone)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
AUTH_AUTO_CONFIRM_EMAIL=false
REAUTH_TOKEN_EXPIRE_MINUTES=10
VITE_IDLE_TIMEOUT_MINUTES=30
VITE_IDLE_WARNING_SECONDS=120
# Leave empty for local dev (Vite proxy handles /api/ routing to localhost:8000)
# Set to your backend URL for cross-origin deployments e.g. https://your-api.onrender.com
VITE_API_URL=
# Private dev console at /dev/progress-test (not in nav). Rebuild frontend after changing.
VITE_DEV_CONSOLE_PASSWORD=change-me-dev-only
OPENAI_API_KEY=your-openai-api-key
# Optional server-side translation provider. Leave blank when using OpenAI.
LIBRETRANSLATE_URL=
GOOGLE_CLOUD_TRANSLATION_API_KEY=
GOOGLE_TRANSLATE_URL=https://translation.googleapis.com/language/translate/v2
# Distance Matrix API for worker mileage auto-calculation (CARECLIQV2-292)
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=your-anthropic-api-key
PII_ENCRYPTION_ENABLED=false
PII_ENCRYPTION_KEY=
# Automatic invitation email via Google Workspace/Gmail SMTP.
# Use a Google App Password, not your normal Google password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-google-workspace-email@example.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-google-workspace-email@example.com
SMTP_FROM_NAME=CareCliQ
SMTP_USE_STARTTLS=true
# Background SMTP queue (in-process). Keeps API fast when many emails send at once.
EMAIL_QUEUE_WORKERS=1
EMAIL_QUEUE_MAX_SIZE=1000
# Worker notification scheduler (shift reminders + credential expiry).
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_MINUTES=15
SHIFT_REMINDER_HOURS_AHEAD=24
# Expo push (optional dev fallback). Mobile FCM uses native tokens via EAS builds.
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Backend FCM (firebase-admin) — sends push to Android/iOS
# NOT the same as google-services.json (that file is for the mobile app only).
#
# Download: Firebase Console → carecliq-13c18 → ⚙️ Project settings
#           → Service accounts → Generate new private key
# Save to:  backend/secrets/firebase-service-account.json  (never commit)
#
FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=/app/backend/secrets/firebase-service-account.json
# Alternative (single-line JSON, awkward in Docker — prefer PATH above):
# FIREBASE_CREDENTIALS_JSON=

# Mobile app API (Expo) — used by docker-compose.dev.yml mobile service
# Browser / Expo web in Docker:
# EXPO_PUBLIC_API_URL=http://localhost:8000
# Expo Go on physical phone (same WiFi; WSL2: use Windows LAN IP, not localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Also add http://192.168.1.100:8000 to CORS_ORIGINS above.
# Production EAS build:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com

BASE_PATH=/
PORT=3000

# ── Task evidence object storage (CARECLIQV2-230) ─────────────────────────────
# Default provider is Supabase Storage (session-evidence bucket).
# Set ONE of the options below to use AWS S3 or Azure Blob instead.

# Explicit provider: supabase | s3 | azure
EVIDENCE_STORAGE_PROVIDER=supabase

# Or use boolean flags (S3 takes priority over Azure if both are true)
EVIDENCE_STORAGE_S3_ENABLED=false
EVIDENCE_STORAGE_AZURE_ENABLED=false

# Supabase bucket name (when provider=supabase)
EVIDENCE_STORAGE_BUCKET=session-evidence

# AWS S3 (when EVIDENCE_STORAGE_S3_ENABLED=true or EVIDENCE_STORAGE_PROVIDER=s3)
EVIDENCE_AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=ap-southeast-2
# Optional — for MinIO / S3-compatible endpoints
EVIDENCE_S3_ENDPOINT_URL=

# ── k6 performance testing ────────────────────────────────────────────────────
# Full guide: performance/README.md
K6_BASE_URL=http://localhost:8000
K6_ENV=Local
K6_TEST_NAME=load
K6_SAVE_HISTORY=false
# Coordinator (support_coordinator / admin)
K6_COORDINATOR_EMAIL=
K6_COORDINATOR_PASSWORD=
# Worker (support_worker)
K6_WORKER_EMAIL=
K6_WORKER_PASSWORD=
