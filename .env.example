SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SESSION_SECRET=change-this-to-a-long-random-secret
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
AUTH_AUTO_CONFIRM_EMAIL=false
REAUTH_TOKEN_EXPIRE_MINUTES=10
VITE_IDLE_TIMEOUT_MINUTES=15
VITE_IDLE_WARNING_SECONDS=120

# Legal-record translation uses Google Cloud Translate only.
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/google-credentials.json
GOOGLE_TRANSLATE_LOCATION=global

# Optional compliance/clinical AI features. Not used for legal-record translation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PII_ENCRYPTION_ENABLED=false
PII_ENCRYPTION_KEY=
# Automatic invitation email via Google Workspace/Gmail SMTP.
# Use a Google App Password, not your normal Google password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-google-workspace-email@example.com
SMTP_PASSWORD=your-google-app-password-not-normal-password
SMTP_FROM_EMAIL=your-google-workspace-email@example.com
SMTP_FROM_NAME=CareScribe
SMTP_USE_STARTTLS=true
BASE_PATH=/
PORT=3000
