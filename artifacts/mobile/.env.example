# Mobile (Expo) — optional; docker-compose.dev.yml reads root .env instead
#
# docker compose -f docker-compose.dev.yml up
#   Web:      http://localhost:8081
#   Expo Go:  scan QR in `docker compose logs -f mobile`

# Browser / Expo web
EXPO_PUBLIC_API_URL=http://localhost:8000

# Physical device (Expo Go) — use your machine's LAN IP (WSL2: Windows Wi-Fi IP)
# Also add http://192.168.x.x:8081 and http://192.168.x.x:8000 to CORS_ORIGINS in root .env
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
