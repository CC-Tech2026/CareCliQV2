# CareCliQ mobile — source of truth for EXPO_PUBLIC_* (local Expo + EAS sync)
#
# Local:  loaded automatically by `npx expo start` from this directory
# Docker: docker-compose.dev.yml loads this file for the mobile service
# EAS:    push with:
#   pnpm exec eas env:push preview --path .env --force
#
# Android emulator: localhost → rewritten to 10.0.2.2 in code
# Physical device / LAN APK: set your machine Wi-Fi IP (WSL2: Windows LAN IP)
# Web (__DEV__): same-origin /api proxied by Metro → this URL (no CORS); Android/iOS use this URL directly
# LIVE : https://dev-api-carescribe.onrender.com
EXPO_PUBLIC_API_URL=https://dev-api-carescribe.onrender.com
