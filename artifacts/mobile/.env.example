# Mobile (Expo) — copy to artifacts/mobile/.env for local dev
# Docker: use docker-compose.dev.yml (mobile runs on http://localhost:8081)

# Browser / Expo web — backend via Docker published port
EXPO_PUBLIC_API_URL=http://localhost:8000

# Physical device on same WiFi (not Docker web) — use your machine's LAN IP
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
