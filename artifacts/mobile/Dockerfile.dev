FROM node:22-bookworm-slim

WORKDIR /app

ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    NODE_ENV=development \
    PORT=8081 \
    EXPO_NO_TELEMETRY=1 \
    CHOKIDAR_USEPOLLING=true \
    WATCHPACK_POLLING=true \
    EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0

RUN corepack enable

COPY . .

RUN corepack pnpm install --frozen-lockfile

EXPOSE 8081

CMD ["sh", "-c", "corepack pnpm install --frozen-lockfile && corepack pnpm --filter @workspace/mobile run dev:docker"]
