{
  "expo": {
    "name": "CareScribe",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D55"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos as evidence during clinical sessions",
        "NSMicrophoneUsageDescription": "Record voice notes during clinical sessions",
        "NSPhotoLibraryUsageDescription": "Access photos to attach evidence to sessions"
      }
    },
    "android": {
      "permissions": ["CAMERA", "RECORD_AUDIO", "READ_EXTERNAL_STORAGE"],
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5533CC",
          "sounds": []
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow CareScribe to access your microphone to record voice notes during sessions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
