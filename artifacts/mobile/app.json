{
  "expo": {
    "name": "CareCliQ",
    "slug": "carecliq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carecliq",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFEF0"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "care.cliq2026",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos as evidence during clinical sessions",
        "NSMicrophoneUsageDescription": "Record voice notes during clinical sessions",
        "NSPhotoLibraryUsageDescription": "Access photos to attach evidence to sessions",
        "NSFaceIDUsageDescription": "Unlock CareCliQ and sign in with Face ID.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "care.cliq2026",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#4B3F91"
      },
      "splash": {
        "image": "./assets/images/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFEF0"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "useNextNotificationsApi": true
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      [
        "expo-router",
        {
          "origin": "http://localhost:8081"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFEF0",
          "android": {
            "backgroundColor": "#FFFEF0",
            "image": "./assets/images/logo.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CareCliQ to use Face ID to unlock the app and sign you in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5533CC",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow CareCliQ to access your microphone to record voice notes during sessions."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CareCliQ to use the camera to attach photo evidence to session notes.",
          "photosPermission": "Allow CareCliQ to access your photos to attach evidence to session notes.",
          "microphonePermission": "Allow CareCliQ to record video with sound for session evidence."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "40e0cf2d-8410-4394-9831-0f10c5967a9f"
      }
    },
    "owner": "carecliq"
  }
}
